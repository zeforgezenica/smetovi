---
import HeaderLink from './HeaderLink.astro';
import BurgerMenu from './BurgerMenu/BurgerMenu';
import Weather from './WeatherComponent/WeatherComponent.tsx';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import '@fortawesome/fontawesome-free/css/all.min.css';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Create language-aware URLs
const homeUrl = lang === 'sr' ? '/' : '/en/';
const mapUrl = lang === 'sr' ? '/map' : '/en/map';
const blogUrl = lang === 'sr' ? '/blog' : '/en/blog';
const organizationsUrl = lang === 'sr' ? '/organizations' : '/en/organizations';
const eventsUrl = lang === 'sr' ? '/events' : '/en/events';
const contactUrl = lang === 'sr' ? '/contact' : '/en/contact';
const imagesUrl = lang === 'sr' ? '/Images' : '/en/Images';
const aboutUrl = lang === 'sr' ? '/about' : '/en/about';
---

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const menuButton = document.getElementById('menu-button');
    const menuContainer = document.getElementById('menu-container');
    menuButton?.addEventListener('click', () => {
      menuContainer.classList.toggle('hidden');
      const isHidden = menuContainer.classList.contains('hidden');
      const icon = menuButton.querySelector('i');
      if (icon) {
        icon.className = isHidden
        ? 'fa-solid fa-bars'
        : 'fa-solid fa-xmark';
      }
    });

    // Close mobile menu when clicking on a link
    const mobileLinks = menuContainer?.querySelectorAll('a');
    mobileLinks?.forEach(link => {
      link.addEventListener('click', () => {
        menuContainer.classList.add('hidden');
        const icon = menuButton?.querySelector('i');
        if (icon) {
          icon.className = 'fa-solid fa-bars';
        }
      });
    });
  });
</script>

<header class="fixed top-0 left-0 blur-background w-full shadow-md h-14 flex items-center">
  <nav class="flex items-center justify-between h-full w-full p-2">
    <!-- Logo -->
    <a href={homeUrl}>
      <img 
        id="navbar-logo" 
        src="/smetovi-logo.png" 
        alt="Smetovi Logo" 
        class="p-2 w-35vw md:w-20vw lg:w-64"
      >
    </a>

    <!-- Desktop Navigation -->
    <div class="internal-links hidden md:flex items-center gap-1">
      <HeaderLink href={mapUrl}>{t('nav.map')}</HeaderLink>
      <HeaderLink href={homeUrl}>{t('nav.home')}</HeaderLink>
      <HeaderLink href={blogUrl}>{t('nav.news')}</HeaderLink>
      <HeaderLink href={organizationsUrl}>{t('nav.organizations')}</HeaderLink>
      <HeaderLink href={eventsUrl}>{t('nav.events')}</HeaderLink>
      <HeaderLink href={contactUrl}>{t('nav.contact')}</HeaderLink>
      <HeaderLink href={imagesUrl}>{t('nav.pictures')}</HeaderLink>
      <HeaderLink href={aboutUrl}>{t('nav.about')}</HeaderLink>
    </div>

    <!-- Right side: Language Switcher, Weather, Mobile Menu -->
    <div class="flex items-center gap-2">
      <!-- Language Switcher (Desktop) -->
      <div class="hidden md:block">
        <LanguageSwitcher />
      </div>

      <!-- Weather Component -->
      <div class="weather flex flex-col justify-center items-center">
        <Weather client:load/>
      </div>  

      <!-- Mobile Menu Button -->
      <div class="block md:hidden" id="menu-button" style="cursor: pointer;">
        <i class="fa-solid fa-bars" style="font-size: 32px; position: relative; top:2px;"></i>
      </div>
    </div>
  </nav>
</header>

<!-- Mobile Menu -->
<div id="menu-container" class="hidden md:hidden">
  <BurgerMenu client:load lang={lang} />
</div>

<style>
  header {
    z-index: 1010;
  }
  
  nav a, .weather {
    padding: 0 0.3em;
  }
  
  .internal-links a {
    padding-bottom: 5px;
    padding-top: 5px;
    padding-left: 8px;
    padding-right: 8px;
    color: var(--black);
    border-bottom: 4px solid transparent;
    text-decoration: none;
    font-size: 16px;
    border-inline: 4px solid transparent;
    transition:
      border-bottom-color 0.3s ease-in-out, 
      border-inline-color 0.3s ease-in-out;
    display: inline-block;
    text-decoration: none;
    white-space: nowrap;
  }
  
  .internal-links a:hover {
    border-bottom: 4px solid var(--pumpkin-orange);
    border-inline: 4px solid transparent;
    transition:
      border-bottom-color 0.3s ease-in-out,
      border-inline-color 0.3s ease-in-out;
  }
  
  .internal-links a.active {
    font-weight: bolder;
    border-bottom: 4px solid var(--pumpkin-orange) !important;
    border-inline: 4px solid transparent !important;
  }
  
  #menu-button:hover {
    cursor: pointer;
    color: var(--pumpkin-orange);
  }

  /* Responsive adjustments */
  @media (max-width: 1200px) {
    .internal-links a {
      font-size: 14px;
      padding-left: 6px;
      padding-right: 6px;
    }
  }
  
  @media (max-width: 1024px) {
    .internal-links a {
      font-size: 13px;
      padding-left: 4px;
      padding-right: 4px;
    }
  }
</style>
