---
import PageLayout from "../layouts/PageLayout.astro";
import { getLangFromCookie } from "../i18n/server";
import { t } from "../i18n";

const lang = getLangFromCookie(Astro.cookies.get("lang")?.value);
const tr = t(lang);

const images = [
  {
    src: "/images/gallery/prilaz-smetovima.jpg",
    caption: lang === "en" ? "The road towards Smetovi" : "Put prema Smetovima",
    source: "https://commons.wikimedia.org/wiki/File:Smetovi.JPG",
    author: "Soman",
    license: lang === "en" ? "Public domain" : "Javno vlasništvo",
  },
  {
    src: "/images/gallery/spomenik-smetovi.jpg",
    caption: lang === "en" ? "The monument on Smetovi" : "Spomenik na Smetovima",
    source: "https://commons.wikimedia.org/wiki/File:Smetovi2.JPG",
    author: "Soman",
    license: lang === "en" ? "Public domain" : "Javno vlasništvo",
  },
  {
    src: "/images/gallery/zimski-plato.jpg",
    caption: lang === "en" ? "The snowy Smetovi plateau" : "Snježni plato Smetova",
    source: "https://commons.wikimedia.org/wiki/File:Smetovi_Zenica_20180325_184611.jpg",
    author: "Obsuser",
    license: "CC BY-SA 4.0",
  },
  {
    src: "/images/gallery/planinarski-dom-smetovi.jpg",
    caption: lang === "en" ? "Smet mountain lodge" : "Planinarski dom Smet",
    source: "https://commons.wikimedia.org/wiki/File:Smetoviinn.JPG",
    author: "Soman",
    license: lang === "en" ? "Public domain" : "Javno vlasništvo",
  },
  {
    src: "/images/gallery/pogled-sa-smetova.jpg",
    caption: lang === "en" ? "A view of the surrounding mountains" : "Pogled na okolne planine",
    source: "https://commons.wikimedia.org/wiki/File:Smetovi_Zenica_20180325_170855.jpg",
    author: "Obsuser",
    license: "CC BY-SA 4.0",
  },
  {
    src: "/images/gallery/smetovi-pod-snijegom.jpg",
    caption: lang === "en" ? "Smetovi covered in snow" : "Smetovi pod snijegom",
    source: "https://commons.wikimedia.org/wiki/File:Smetovi_Zenica_20180325_184741.jpg",
    author: "Obsuser",
    license: "CC BY-SA 4.0",
  },
  {
    src: "/images/gallery/zimske-planine.jpg",
    caption: lang === "en" ? "A winter mountain panorama" : "Zimska panorama planina",
    source: "https://commons.wikimedia.org/wiki/File:Smetovi_Zenica_20180325_184607.jpg",
    author: "Obsuser",
    license: "CC BY-SA 4.0",
  },
  {
    src: "/images/gallery/zimski-put.jpg",
    caption: lang === "en" ? "A winter road on Smetovi" : "Zimski put na Smetovima",
    source: "https://commons.wikimedia.org/wiki/File:Smetovi_Zenica_20180325_184613.jpg",
    author: "Obsuser",
    license: "CC BY-SA 4.0",
  },
];

const labels = lang === "en"
  ? {
      eyebrow: "Discover Smetovi",
      open: "Open image",
      close: "Close gallery",
      previous: "Previous image",
      next: "Next image",
      dialog: "Image preview",
      count: "photographs",
      credits: "Photo credits",
      photoBy: "Photo",
      licenseNotice: "The author, source and license are listed with each photograph.",
      contributeEyebrow: "Open gallery",
      contributeTitle: "Share your view of Smetovi",
      contributeText: "Do you have a photograph of Smetovi you would like to share? Email it to us as an attachment and, with your permission, we will add it to the gallery with your name clearly credited.",
      contributeAction: "Send by email",
    }
  : {
      eyebrow: "Otkrijte Smetove",
      open: "Otvori fotografiju",
      close: "Zatvori galeriju",
      previous: "Prethodna fotografija",
      next: "Sljedeća fotografija",
      dialog: "Pregled fotografije",
      count: "fotografija",
      credits: "Autori fotografija",
      photoBy: "Foto",
      licenseNotice: "Autor, izvor i licenca navedeni su uz svaku fotografiju.",
      contributeEyebrow: "Otvorena galerija",
      contributeTitle: "Podijelite svoj pogled na Smetove",
      contributeText: "Imate fotografiju Smetova koju želite podijeliti? Pošaljite nam je kao prilog email poruke i, uz vašu saglasnost, dodat ćemo je u galeriju uz jasno navedeno ime autora.",
      contributeAction: "Pošaljite email",
    };

const contributionSubject = lang === "en"
  ? "Photograph for the Smetovi gallery"
  : "Fotografija za galeriju Smetova";
const contributionBody = lang === "en"
  ? "Hello,\n\nI would like to submit a photograph for the Smetovi gallery. I have attached the photograph to this email.\n\nAuthor name:\nPhotograph description:\n\nI confirm that I am the author of the photograph or that I have permission from the copyright holder to submit it. I grant the smetovi.ba project a non-exclusive, royalty-free permission to publish the photograph, adapt it for display on the web and use it to promote the project, with clear attribution to the author. I confirm that its publication does not infringe the rights of third parties and that I have obtained any necessary consent from identifiable people shown in the photograph."
  : "Pozdrav,\n\nŽelim poslati fotografiju za galeriju Smetova. Fotografiju sam priložio/la uz ovu poruku.\n\nIme autora:\nOpis fotografije:\n\nPotvrđujem da sam autor fotografije ili da imam ovlaštenje nosioca autorskih prava za njeno ustupanje. Dajem projektu smetovi.ba neisključivu i besplatnu dozvolu da fotografiju objavi, prilagodi za prikaz na webu i koristi za promociju projekta, uz navođenje autora. Potvrđujem da objava ne krši prava trećih osoba i da imam potrebne saglasnosti prepoznatljivih osoba na fotografiji.";
const contributionHref = `mailto:info@zeforge.ba?subject=${encodeURIComponent(contributionSubject)}&body=${encodeURIComponent(contributionBody)}`;
---

<PageLayout
  siteTitle={`${tr.gallery.title} | Smetovi`}
  siteDescription={tr.gallery.description}
>
  <main class="gallery-page">
    <header class="gallery-header">
      <p class="gallery-eyebrow">{labels.eyebrow}</p>
      <h1>{tr.gallery.title}</h1>
      <div class="gallery-accent" aria-hidden="true"></div>
      <p class="gallery-description">{tr.gallery.description}</p>
      <span class="gallery-count">{images.length} {labels.count}</span>
    </header>

    <section class="gallery-grid" aria-label={tr.gallery.title}>
      {images.map((image, index) => (
        <figure class="gallery-card">
          <button
            class="gallery-item"
            type="button"
            data-gallery-index={index}
            aria-label={`${labels.open}: ${image.caption}`}
          >
            <img
              src={image.src}
              alt={image.caption}
              loading={index < 2 ? "eager" : "lazy"}
              decoding="async"
            />
            <span class="gallery-item__overlay">
              <span>{image.caption}</span>
              <span class="gallery-item__icon" aria-hidden="true">↗</span>
            </span>
          </button>
          <figcaption class="gallery-card__credit">
            <span>{labels.photoBy}:</span>
            <a href={image.source} target="_blank" rel="noreferrer">
              {image.author}
            </a>
            <span aria-hidden="true">·</span>
            <span>{image.license}</span>
          </figcaption>
        </figure>
      ))}
    </section>

    <aside class="gallery-contribution">
      <div>
        <p class="gallery-contribution__eyebrow">{labels.contributeEyebrow}</p>
        <h2>{labels.contributeTitle}</h2>
        <p>{labels.contributeText}</p>
      </div>
      <a href={contributionHref}>
        {labels.contributeAction}
        <span aria-hidden="true">→</span>
      </a>
    </aside>

    <aside class="gallery-credits" aria-label={labels.credits}>
      <span>{labels.licenseNotice}</span>
    </aside>
  </main>

  <div
    id="image-slider"
    class="slider-modal"
    role="dialog"
    aria-modal="true"
    aria-label={labels.dialog}
    aria-hidden="true"
  >
    <div class="slider-backdrop" data-slider-close></div>

    <button
      class="slider-control slider-close"
      type="button"
      data-slider-close
      aria-label={labels.close}
    >
      <span aria-hidden="true">×</span>
    </button>

    <button
      class="slider-control slider-previous"
      type="button"
      data-slider-direction="-1"
      aria-label={labels.previous}
    >
      <span aria-hidden="true">‹</span>
    </button>

    <figure class="slider-content">
      <img id="slider-image" src="" alt="" />
      <figcaption>
        <span id="slider-caption"></span>
        <span id="slider-counter" class="slider-counter"></span>
      </figcaption>
    </figure>

    <button
      class="slider-control slider-next"
      type="button"
      data-slider-direction="1"
      aria-label={labels.next}
    >
      <span aria-hidden="true">›</span>
    </button>
  </div>
</PageLayout>

<style>
  :global(body) {
    margin: 0;
    background: #f8fafc;
  }

  .gallery-page {
    min-height: 100vh;
    padding: 7.5rem 1.25rem 5rem;
    font-family: "Atkinson", sans-serif;
  }

  .gallery-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 760px;
    margin: 0 auto 3rem;
    text-align: center;
  }

  .gallery-eyebrow {
    margin: 0 0 0.65rem;
    color: #d86420;
    font-family: "Exo2", sans-serif;
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .gallery-header h1 {
    margin: 0;
    color: #082f49;
    font-family: "Exo2", sans-serif;
    font-size: clamp(2.4rem, 6vw, 4.25rem);
    line-height: 1.05;
    text-transform: uppercase;
  }

  .gallery-accent {
    width: 5.5rem;
    height: 4px;
    margin: 1rem 0 1.15rem;
    background: #f97316;
  }

  .gallery-description {
    max-width: 620px;
    margin: 0;
    color: #5b6870;
    font-size: clamp(1rem, 2vw, 1.15rem);
    line-height: 1.65;
  }

  .gallery-count {
    margin-top: 1rem;
    border-radius: 999px;
    background: #e5eef2;
    padding: 0.4rem 0.75rem;
    color: #335263;
    font-size: 0.78rem;
    font-weight: 700;
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-auto-rows: 235px;
    gap: 1rem;
    width: min(1180px, 100%);
    margin: 0 auto;
  }

  .gallery-item {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    min-width: 0;
    overflow: hidden;
    cursor: zoom-in;
    border: 0;
    border-radius: 16px;
    background: #dce5e9;
    padding: 0;
    box-shadow: 0 12px 30px rgba(8, 47, 73, 0.1);
  }

  .gallery-card {
    display: grid;
    grid-column: span 4;
    grid-template-rows: minmax(0, 1fr) auto;
    min-width: 0;
    margin: 0;
  }

  .gallery-card:nth-child(1),
  .gallery-card:nth-child(6) {
    grid-column: span 8;
  }

  .gallery-card:nth-child(2),
  .gallery-card:nth-child(5) {
    grid-row: span 2;
  }

  .gallery-card__credit {
    padding: 0.6rem 0.25rem 0;
    color: #6b7b83;
    font-size: 0.76rem;
    line-height: 1.4;
  }

  .gallery-card__credit a {
    color: #285f76;
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .gallery-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 450ms ease;
  }

  .gallery-item__overlay {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    min-height: 45%;
    background: linear-gradient(transparent, rgba(4, 30, 43, 0.82));
    padding: 2.5rem 1rem 1rem;
    color: white;
    font-family: "Exo2", sans-serif;
    font-weight: 700;
    opacity: 0;
    transition: opacity 250ms ease;
  }

  .gallery-item__icon {
    display: grid;
    flex: 0 0 34px;
    width: 34px;
    height: 34px;
    place-items: center;
    border: 1px solid rgba(255, 255, 255, 0.55);
    border-radius: 50%;
    font-size: 1.15rem;
  }

  .gallery-item:hover img,
  .gallery-item:focus-visible img {
    transform: scale(1.045);
  }

  .gallery-item:hover .gallery-item__overlay,
  .gallery-item:focus-visible .gallery-item__overlay {
    opacity: 1;
  }

  .gallery-item:focus-visible {
    outline: 4px solid rgba(249, 115, 22, 0.65);
    outline-offset: 3px;
  }

  .gallery-credits {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: center;
    gap: 0.35rem;
    width: min(1180px, 100%);
    margin: 1.5rem auto 0;
    color: #667881;
    font-size: 0.78rem;
    line-height: 1.6;
    text-align: center;
  }

  .gallery-contribution {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    box-sizing: border-box;
    width: min(1180px, 100%);
    margin: 2rem auto 0;
    overflow: hidden;
    border-radius: 16px;
    background:
      radial-gradient(circle at 90% 10%, rgba(255, 255, 255, 0.12), transparent 30%),
      #082f49;
    padding: clamp(1.5rem, 4vw, 2.25rem);
    color: white;
    box-shadow: 0 12px 30px rgba(8, 47, 73, 0.13);
  }

  .gallery-contribution > div {
    max-width: 730px;
  }

  .gallery-contribution__eyebrow {
    margin: 0 0 0.4rem;
    color: #fdba74;
    font-family: "Exo2", sans-serif;
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .gallery-contribution h2 {
    margin: 0;
    color: #ffffff;
    font-family: "Exo2", sans-serif;
    font-size: clamp(1.45rem, 3vw, 2rem);
    font-weight: 800;
    line-height: 1.2;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.2);
  }

  .gallery-contribution p:last-child {
    margin: 0.75rem 0 0;
    color: #d8e5eb;
    line-height: 1.65;
  }

  .gallery-contribution > a {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 0.55rem;
    border-radius: 9px;
    background: #f97316;
    padding: 0.8rem 1.1rem;
    color: white;
    font-weight: 800;
    text-decoration: none;
    transition: background 160ms ease, transform 160ms ease;
  }

  .gallery-contribution > a:hover {
    background: #ea580c;
    transform: translateY(-1px);
  }

  .gallery-contribution > a:focus-visible {
    outline: 3px solid white;
    outline-offset: 3px;
  }

  .gallery-credits a {
    color: #285f76;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .slider-modal {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: grid;
    visibility: hidden;
    grid-template-columns: 5rem minmax(0, 1fr) 5rem;
    align-items: center;
    padding: 1.5rem;
    opacity: 0;
    transition: opacity 220ms ease, visibility 220ms ease;
  }

  .slider-modal.is-open {
    visibility: visible;
    opacity: 1;
  }

  .slider-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(3, 16, 23, 0.94);
    backdrop-filter: blur(8px);
  }

  .slider-content {
    position: relative;
    z-index: 1;
    grid-column: 2;
    margin: 0;
    text-align: center;
  }

  .slider-content img {
    display: block;
    width: auto;
    max-width: 100%;
    height: auto;
    max-height: min(76vh, 820px);
    margin: 0 auto;
    border-radius: 8px;
    object-fit: contain;
    box-shadow: 0 18px 60px rgba(0, 0, 0, 0.55);
  }

  .slider-content figcaption {
    display: flex;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 1rem;
    color: white;
    font-size: 0.95rem;
  }

  .slider-counter {
    color: #9db0ba;
  }

  .slider-control {
    position: relative;
    z-index: 2;
    display: grid;
    width: 48px;
    height: 48px;
    place-items: center;
    cursor: pointer;
    border: 1px solid rgba(255, 255, 255, 0.35);
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.08);
    color: white;
    font-size: 2.4rem;
    line-height: 1;
    transition: background 160ms ease, transform 160ms ease;
  }

  .slider-control:hover {
    background: rgba(255, 255, 255, 0.18);
    transform: scale(1.06);
  }

  .slider-control:focus-visible {
    outline: 3px solid #f97316;
    outline-offset: 3px;
  }

  .slider-previous {
    grid-column: 1;
    justify-self: start;
  }

  .slider-next {
    grid-column: 3;
    justify-self: end;
  }

  .slider-close {
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
    font-size: 2rem;
  }

  @media (max-width: 900px) {
    .gallery-grid {
      grid-auto-rows: 220px;
    }

    .gallery-card,
    .gallery-card:nth-child(1),
    .gallery-card:nth-child(6) {
      grid-column: span 6;
    }

    .gallery-card:nth-child(2),
    .gallery-card:nth-child(5) {
      grid-row: span 1;
    }

    .slider-modal {
      grid-template-columns: 3.5rem minmax(0, 1fr) 3.5rem;
      padding: 1rem;
    }
  }

  @media (max-width: 600px) {
    .gallery-page {
      padding: 6.5rem 1rem 4rem;
    }

    .gallery-header {
      margin-bottom: 2rem;
    }

    .gallery-grid {
      grid-template-columns: 1fr;
      grid-auto-rows: auto;
      gap: 0.85rem;
    }

    .gallery-card,
    .gallery-card:nth-child(1),
    .gallery-card:nth-child(6) {
      grid-column: 1;
      grid-template-rows: auto auto;
    }

    .gallery-item {
      aspect-ratio: 4 / 3;
    }

    .gallery-item__overlay {
      opacity: 1;
    }

    .gallery-contribution {
      align-items: flex-start;
      flex-direction: column;
      gap: 1.25rem;
    }

    .gallery-contribution > a {
      box-sizing: border-box;
      width: 100%;
      justify-content: center;
    }

    .slider-modal {
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 4.5rem 0.75rem 5rem;
    }

    .slider-content {
      width: 100%;
    }

    .slider-content img {
      max-height: 70vh;
    }

    .slider-previous,
    .slider-next {
      position: absolute;
      bottom: 1rem;
    }

    .slider-previous {
      left: calc(50% - 3.75rem);
    }

    .slider-next {
      right: calc(50% - 3.75rem);
    }

    .slider-close {
      top: 1rem;
      right: 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gallery-item img,
    .gallery-item__overlay,
    .slider-modal,
    .slider-control {
      transition: none;
    }
  }
</style>

<script>
  const modal = document.querySelector<HTMLElement>("#image-slider");
  const modalImage = document.querySelector<HTMLImageElement>("#slider-image");
  const modalCaption = document.querySelector<HTMLElement>("#slider-caption");
  const modalCounter = document.querySelector<HTMLElement>("#slider-counter");
  const galleryItems = Array.from(
    document.querySelectorAll<HTMLButtonElement>("[data-gallery-index]")
  );
  const closeButtons = document.querySelectorAll<HTMLElement>("[data-slider-close]");
  const directionButtons = document.querySelectorAll<HTMLButtonElement>(
    "[data-slider-direction]"
  );

  let currentIndex = 0;
  let lastFocusedElement: HTMLElement | null = null;

  function updateSlider() {
    const selected = galleryItems[currentIndex];
    const image = selected?.querySelector<HTMLImageElement>("img");

    if (!image || !modalImage || !modalCaption || !modalCounter) return;

    modalImage.src = image.src;
    modalImage.alt = image.alt;
    modalCaption.textContent = image.alt;
    modalCounter.textContent = `${currentIndex + 1} / ${galleryItems.length}`;
  }

  function openSlider(index: number) {
    if (!modal) return;

    currentIndex = index;
    lastFocusedElement = document.activeElement as HTMLElement;
    updateSlider();
    modal.classList.add("is-open");
    modal.setAttribute("aria-hidden", "false");
    document.body.style.overflow = "hidden";
    modal.querySelector<HTMLButtonElement>(".slider-close")?.focus();
  }

  function closeSlider() {
    if (!modal) return;

    modal.classList.remove("is-open");
    modal.setAttribute("aria-hidden", "true");
    document.body.style.overflow = "";
    lastFocusedElement?.focus();
  }

  function changeSlide(direction: number) {
    currentIndex =
      (currentIndex + direction + galleryItems.length) % galleryItems.length;
    updateSlider();
  }

  galleryItems.forEach((item, index) => {
    item.addEventListener("click", () => openSlider(index));
  });

  closeButtons.forEach((button) => {
    button.addEventListener("click", closeSlider);
  });

  directionButtons.forEach((button) => {
    button.addEventListener("click", () => {
      changeSlide(Number(button.dataset.sliderDirection));
    });
  });

  document.addEventListener("keydown", (event) => {
    if (!modal?.classList.contains("is-open")) return;

    if (event.key === "Escape") closeSlider();
    if (event.key === "ArrowLeft") changeSlide(-1);
    if (event.key === "ArrowRight") changeSlide(1);
  });
</script>
