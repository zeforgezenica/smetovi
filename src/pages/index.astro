---
import PageLayout from "../layouts/PageLayout.astro";
import { getLangFromCookie } from "../i18n/server";
import { t } from "../i18n";
import { getWeatherIcon } from "../components/WeatherComponent/weatherIconMap";

const lang = getLangFromCookie(Astro.cookies.get("lang")?.value);
const tr = t(lang);

interface ServiceWeather {
  temperature: number;
  code: number;
  difficult: boolean;
}

interface ServiceWeatherResponse {
  current: {
    temperature_2m: number;
    precipitation_probability: number;
    weather_code: number;
  };
}

let serviceWeather: ServiceWeather | null = null;

try {
  const weatherUrl = "https://api.open-meteo.com/v1/forecast?latitude=44.2447&longitude=17.9781&current=temperature_2m,precipitation_probability,weather_code&timezone=Europe%2FSarajevo";
  const response = await fetch(weatherUrl);

  if (response.ok) {
    const data = (await response.json()) as ServiceWeatherResponse;
    const current = data.current;
    const snowCodes = [71, 73, 75, 77, 85, 86];
    const iceCodes = [56, 57, 66, 67];
    const difficult = snowCodes.includes(current.weather_code)
      || iceCodes.includes(current.weather_code)
      || (current.temperature_2m <= 0 && current.precipitation_probability > 20);

    serviceWeather = {
      temperature: Math.round(current.temperature_2m),
      code: current.weather_code,
      difficult,
    };
  }
} catch (error) {
  console.error("Homepage weather fetch failed:", error);
}
---

<PageLayout
  siteTitle={tr.index.meta_title}
  siteDescription={tr.index.meta_description}
>
  <main id="main" class="landing-background">
    <img id="logo" src="/smetovi-logo.png" alt={tr.index.hero_alt} srcset="" />
    <h1 class="sr-only">{tr.index.hero_title}</h1>
    <a class="explore-link" href="#upoznaj-smetove">
      <span>{tr.index.hero_explore}</span>
      <svg aria-hidden="true" viewBox="0 0 24 24">
        <path d="m6 9 6 6 6-6"></path>
      </svg>
    </a>
  </main>
  <!-- Monument -->
  <div id="upoznaj-smetove" class="flex max-sm:flex-col lg:h-screen overflow-hidden observed">
    <div class="relative w-3/5 max-sm:w-screen fade slide-left">
      <img
          src="/tmp-images/Monument_s.jpg"
          alt=""
          width="100%"
          class="z-0 h-full w-full object-cover"
          style="filter: brightness(1.5);"
      />
      <div class="absolute inset-0 bg-gradient-to-r max-sm:bg-gradient-to-b from-transparent from-50% to-white"></div>
    </div>
    <div class="relative w-2/5 max-sm:w-screen z-10 items-center -ml-20 max-sm:ml-0 mt-[120px] max-sm:-mt-40 text-blue-950 max-sm:p-4 fade slide-bottom">
      <h2 class="text-3xl font-exo2 font-bold mb-2 text-blue-950">{tr.index.section1_title}</h2>
      <div class="ttl-sep w-20 h-1 bg-orange-500 my-2"></div>
      <p class="mt-5 text-[18px]">{tr.index.section1_p1}</p>
      <p class="mt-4 text-[18px]">{tr.index.section1_p2}</p>

     <div class="flex flex-wrap gap-4 mt-5">
        <a
          href="/map"
          class="home-cta home-cta--primary inline-block bg-blue-950 px-10 py-2 text-white no-underline"
          style="clip-path: polygon(0 0, calc(100% - 10px) 0, 100% 10px, 100% 100%, 10px 100%, 0 calc(100% - 10px));"
        >
          {tr.index.section1_btn}
        </a>

        <a
          href="/spomenik"
          class="home-cta home-cta--secondary inline-block px-10 py-2 text-white font-bold no-underline"
          style="clip-path: polygon(0 0, calc(100% - 10px) 0, 100% 10px, 100% 100%, 10px 100%, 0 calc(100% - 10px));"
        >
          {tr.index.monument_btn}
        </a>
      </div>

    </div>
  </div>
  <!-- Flora and fauna -->
  <div class="flex max-sm:flex-col-reverse lg:h-screen overflow-hidden observed">
    <div class="relative w-2/5 max-sm:w-screen z-10 items-center ml-20 -mr-20 max-sm:ml-0 max-sm:mr-0 mt-[120px] max-sm:-mt-40 text-blue-950 max-sm:p-4 fade slide-bottom">
      <h2 class="text-3xl font-exo2 font-bold mb-2 text-blue-950">{tr.index.section2_title}</h2>
      <div class="ttl-sep w-20 h-1 bg-orange-500 my-2"></div>
      <p class="mt-5 text-[18px]">{tr.index.section2_p1}</p>
      <p class="mt-4 text-[18px]">{tr.index.section2_p2}</p>
      <a
        href="/gallery"
        class="home-cta home-cta--primary inline-block bg-blue-950 px-10 py-2 mt-5 text-white no-underline"
        style="clip-path: polygon(0 0, calc(100% - 10px) 0, 100% 10px, 100% 100%, 10px 100%, 0 calc(100% - 10px));"
      >
        {tr.index.section2_btn}
      </a>
    </div>
    <div class="relative w-3/5 max-sm:w-screen fade slide-right">
      <picture>
        <source media="(max-width: 640px)" srcset="/tmp-images/Fox_s.jpg" />
        <source media="(min-width: 641px)" srcset="/tmp-images/Fox.jpg" />
        <img
            src="/tmp-images/Fox.jpg"
            alt=""
            width="100%"
            class="z-0 h-full w-full object-cover"
            style="transform: scaleX(-1);"
        />
      </picture>
      <div class="absolute inset-0 bg-gradient-to-l max-sm:bg-gradient-to-b from-transparent from-50% to-white"></div>
    </div>
  </div>
  <!-- Active escape -->
  <div class="flex max-sm:flex-col lg:h-screen overflow-hidden observed">
    <div class="relative w-3/5 max-sm:w-screen fade slide-left">
      <img
        src="/images/organizations/adrenalinskipark/adrenalinskipark.jpg"
        alt=""
        width="100%"
        class="z-0 h-full w-full object-cover"
      />
      <div class="absolute inset-0 bg-gradient-to-r max-sm:bg-gradient-to-b from-transparent from-50% to-white"></div>
    </div>
    <div class="relative w-2/5 max-sm:w-screen z-10 items-center -ml-20 max-sm:ml-0 mt-[120px] max-sm:mt-0 text-blue-950 max-sm:p-4 fade slide-bottom">
      <h2 class="text-3xl font-exo2 font-bold mb-2 text-blue-950">{tr.index.section3_title}</h2>
      <div class="ttl-sep w-20 h-1 bg-orange-500 my-2"></div>
      <p class="mt-5 text-[18px]">{tr.index.section3_p1}</p>
      <p class="mt-4 text-[18px]">{tr.index.section3_p2}</p>
      <a
        href="/map"
        class="home-cta home-cta--primary inline-block bg-blue-950 px-10 py-2 mt-5 text-white no-underline"
        style="clip-path: polygon(0 0, calc(100% - 10px) 0, 100% 10px, 100% 100%, 10px 100%, 0 calc(100% - 10px));"
      >
        {tr.index.section3_btn}
      </a>
    </div>
  </div>
  {serviceWeather && (
    <section class="service-section">
      <aside class="service-card" aria-labelledby="service-title">
        <div class="service-weather">
          <img
            src={getWeatherIcon(serviceWeather.code)}
            alt=""
            aria-hidden="true"
          />
          <div>
            <p id="service-title">{tr.index.service_title}</p>
            <strong>{serviceWeather.temperature}°C</strong>
          </div>
        </div>
        <div class="service-road">
          <span>{tr.index.road_estimate}</span>
          <strong class:list={{ difficult: serviceWeather.difficult }}>
            {serviceWeather.difficult ? tr.index.road_difficult : tr.index.road_passable}
          </strong>
        </div>
        <a href="/weather">
          {tr.index.weather_details}
          <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
        </a>
      </aside>
    </section>
  )}
</PageLayout>

<style>
  :global(html) {
    scroll-behavior: smooth;
  }
  .landing-background {
    background-image: url("/landing-image.png");
    background-size: cover;
    background-position: center;
    position: relative;
    height: 100vh;
    width: 100vw;
    color: white;
    display: flex;
    justify-content: center;
    align-items: center;
  }
  main img { max-width: 100%; height: auto; }
  .explore-link {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.2rem;
    color: white;
    font-family: "Exo2", sans-serif;
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-decoration: none;
    text-shadow: 0 1px 8px rgb(0 0 0 / 70%);
    text-transform: uppercase;
    transform: translateX(-50%);
    transition: color 0.2s ease;
  }
  .explore-link:hover {
    color: var(--pumpkin-orange);
  }
  .explore-link:focus-visible {
    border-radius: 0.25rem;
    outline: 3px solid var(--pumpkin-orange);
    outline-offset: 0.4rem;
  }
  .explore-link svg {
    width: 1.75rem;
    height: 1.75rem;
    animation: explore-bounce 1.8s ease-in-out infinite;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2;
  }
  .home-cta {
    box-shadow: 0 5px 12px rgb(15 23 42 / 10%);
    transition: background-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
  }
  .home-cta:hover {
    color: #fff;
    box-shadow: 0 8px 18px rgb(15 23 42 / 18%);
    transform: translateY(-2px);
  }
  .home-cta--primary:hover {
    background-color: var(--pumpkin-orange);
  }
  .home-cta--secondary {
    background-color: var(--pumpkin-orange);
  }
  .home-cta--secondary:hover {
    background-color: #172554;
  }
  .home-cta:focus-visible {
    color: #fff;
    outline: 3px solid var(--pumpkin-orange);
    outline-offset: 3px;
  }
  .service-section {
    padding: 3.5rem 1rem;
    background: #fff;
  }
  .service-card {
    display: grid;
    width: min(1050px, 100%);
    margin: 0 auto;
    padding: 1.25rem 1.5rem;
    grid-template-columns: minmax(220px, 1fr) minmax(250px, 1fr) auto;
    align-items: center;
    gap: 2rem;
    background: #fff;
    color: #172554;
    font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }
  .service-weather {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .service-weather img {
    width: 3.6rem;
    height: 3.6rem;
    object-fit: contain;
  }
  .service-weather p,
  .service-road span {
    margin: 0;
    color: #64748b;
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .service-weather strong {
    display: block;
    margin-top: 0.1rem;
    color: #111827;
    font-size: 1.8rem;
    line-height: 1;
  }
  .service-road {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin: 0;
    padding: 0 2rem;
    border-right: 1px solid #e5e7eb;
    border-left: 1px solid #e5e7eb;
  }
  .service-road strong {
    padding: 0.38rem 0.7rem;
    border-radius: 999px;
    background: #16a34a;
    color: white;
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    line-height: 1;
    text-transform: uppercase;
  }
  .service-road strong.difficult {
    background: #ea580c;
  }
  .service-card > a {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin: 0;
    white-space: nowrap;
    color: #ea580c;
    font-size: 0.88rem;
    font-weight: 700;
    text-decoration: none;
  }
  .service-card > a:hover {
    color: #c2410c;
  }
  #upoznaj-smetove {
    scroll-margin-top: 3.5rem;
  }
  @keyframes explore-bounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(0.35rem); }
  }
  .fade { opacity: 1; }
  :global(.animations-ready) .fade {
    opacity: 0;
    transition: opacity 1s ease, transform 1s ease;
  }
  @media (prefers-reduced-motion: reduce) {
    :global(html) { scroll-behavior: auto; }
    .fade { transition: none; }
    .explore-link svg { animation: none; }
  }
  :global(.animations-ready) .slide-left { transform: translateX(-50px); }
  :global(.animations-ready) .slide-right { transform: translateX(50px); }
  :global(.animations-ready) .slide-bottom { transform: translateY(50px); }
  :global(.animations-ready) .show { opacity: 1; transform: translateX(0); }
  @media (max-width: 760px) {
    .service-section {
      padding: 2rem 1rem;
    }
    .service-card {
      grid-template-columns: 1fr;
      gap: 0;
      padding: 1rem;
    }
    .service-road {
      margin-top: 0.85rem;
      padding: 0.8rem 0;
      border-top: 1px solid #e5e7eb;
      border-right: 0;
      border-bottom: 1px solid #e5e7eb;
      border-left: 0;
    }
    .service-card > a {
      margin-top: 0.85rem;
    }
    .explore-link {
      bottom: 1.5rem;
    }
  }
</style>

<script>
  document.documentElement.classList.add("animations-ready");

  const main = document.getElementById("main");
  const logo = document.getElementById("logo");

  const logoObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          let ratio = entry.intersectionRatio;
          let opacity = (ratio - 0.5) / 0.5;
          opacity = Math.max(0, Math.min(1, opacity));
          if (logo != null) logo.style.opacity = opacity.toString();
        });
      },
      { threshold: Array.from({ length: 101 }, (_, i) => i / 100) }
  );
  if (main != null) logoObserver.observe(main);

  const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.firstElementChild?.classList.add("show");
            entry.target.lastElementChild?.classList.add("show");
          } else {
            entry.target.firstElementChild?.classList.remove("show");
            entry.target.lastElementChild?.classList.remove("show");
          }
        });
      },
      { threshold: 0.15 }
  );

  const observedElements = document.querySelectorAll(".observed");
  observedElements.forEach((el) => observer.observe(el));
</script>
