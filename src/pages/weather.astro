---
import PageLayout from "../layouts/PageLayout.astro";
import { getWeatherIcon } from "../components/WeatherComponent/weatherIconMap";
import { t } from "../i18n";
import { getLangFromCookie } from "../i18n/server";

interface OpenMeteoResponse {
    current: {
        time: string;
        temperature_2m: number;
        relative_humidity_2m: number;
        apparent_temperature: number;
        is_day: number;
        precipitation_probability: number;
        weather_code: number;
        wind_speed_10m: number;
    };
    hourly: {
        time: string[];
        temperature_2m: number[];
        weather_code: number[];
    };
    daily: {
        time: string[];
        weather_code: number[];
        temperature_2m_max: number[];
        temperature_2m_min: number[];
        precipitation_probability_max: number[];
    };
}

interface HourlyForecast {
    time: string;
    temp: number;
    code: number;
}

interface DailyForecast {
    date: string;
    code: number;
    high: number;
    low: number;
    precip: number;
}

const lang = getLangFromCookie(Astro.cookies.get("lang")?.value);
const tr = t(lang);
const locale = lang === "bs" ? "bs-BA" : "en-GB";
const lat = 44.2447;
const lon = 17.9781;
const apiUrl = `https://api.open-meteo.com/v1/forecast?latitude=${lat}&longitude=${lon}&current=temperature_2m,relative_humidity_2m,apparent_temperature,is_day,precipitation_probability,weather_code,wind_speed_10m&hourly=temperature_2m,weather_code&daily=weather_code,temperature_2m_max,temperature_2m_min,precipitation_probability_max&timezone=Europe%2FSarajevo&forecast_days=7`;

const descriptions = {
    bs: {
        0: "Vedro", 1: "Pretežno vedro", 2: "Djelimično oblačno", 3: "Oblačno",
        45: "Magla", 48: "Magla s injem", 51: "Blaga rosulja", 53: "Rosulja", 55: "Jaka rosulja",
        56: "Ledena rosulja", 57: "Jaka ledena rosulja", 61: "Slaba kiša", 63: "Umjerena kiša",
        65: "Jaka kiša", 66: "Ledena kiša", 67: "Jaka ledena kiša", 71: "Slab snijeg",
        73: "Snijeg", 75: "Jak snijeg", 77: "Zrnast snijeg", 80: "Slabi pljuskovi",
        81: "Pljuskovi", 82: "Jaki pljuskovi", 85: "Pljusak snijega", 86: "Jak pljusak snijega",
        95: "Grmljavina", 96: "Grmljavina s gradom", 99: "Jaka grmljavina s gradom"
    },
    en: {
        0: "Clear", 1: "Mainly clear", 2: "Partly cloudy", 3: "Overcast",
        45: "Fog", 48: "Rime fog", 51: "Light drizzle", 53: "Drizzle", 55: "Heavy drizzle",
        56: "Freezing drizzle", 57: "Heavy freezing drizzle", 61: "Light rain", 63: "Moderate rain",
        65: "Heavy rain", 66: "Freezing rain", 67: "Heavy freezing rain", 71: "Light snow",
        73: "Snow", 75: "Heavy snow", 77: "Snow grains", 80: "Light showers",
        81: "Showers", 82: "Heavy showers", 85: "Snow showers", 86: "Heavy snow showers",
        95: "Thunderstorm", 96: "Thunderstorm with hail", 99: "Heavy thunderstorm with hail"
    }
} as const;

let weather: OpenMeteoResponse["current"] | null = null;
let hourlyForecast: HourlyForecast[] = [];
let dailyForecast: DailyForecast[] = [];
let error = false;
let isDifficult = false;
let showWarning = false;

try {
    const response = await fetch(apiUrl);
    if (!response.ok) throw new Error(`Open-Meteo: ${response.status}`);

    const data = (await response.json()) as OpenMeteoResponse;
    weather = data.current;

    const firstHour = Math.max(0, data.hourly.time.findIndex((time) => time >= data.current.time));
    hourlyForecast = data.hourly.time.slice(firstHour, firstHour + 8).map((time, index) => ({
        time,
        temp: Math.round(data.hourly.temperature_2m[firstHour + index]),
        code: data.hourly.weather_code[firstHour + index]
    }));

    dailyForecast = data.daily.time.map((date, index) => ({
        date,
        code: data.daily.weather_code[index],
        high: Math.round(data.daily.temperature_2m_max[index]),
        low: Math.round(data.daily.temperature_2m_min[index]),
        precip: data.daily.precipitation_probability_max[index]
    }));

    const snowCodes = [71, 73, 75, 77, 85, 86];
    const iceCodes = [56, 57, 66, 67];
    const isSnowing = snowCodes.includes(weather.weather_code);
    const hasIceRisk = iceCodes.includes(weather.weather_code)
        || (weather.temperature_2m <= 0 && weather.precipitation_probability > 20);
    showWarning = isSnowing || hasIceRisk;
    isDifficult = showWarning;
} catch (err) {
    console.error("Weather fetch failed:", err);
    error = true;
}

function getWeatherDesc(code: number): string {
    const dictionary = descriptions[lang] as Record<number, string>;
    return dictionary[code] ?? (lang === "bs" ? "Promjenjivo" : "Variable");
}

function formatDate(value: string, options: Intl.DateTimeFormatOptions): string {
    return new Intl.DateTimeFormat(locale, options).format(new Date(`${value}T12:00:00`));
}

function formatUpdated(value: string): string {
    const [date, time] = value.split("T");
    return `${formatDate(date, { day: "2-digit", month: "2-digit", year: "numeric" })} · ${time}`;
}
---

<PageLayout siteTitle={`${tr.weather.title} | Smetovi`} siteDescription={tr.weather.description}>
    <main class="weather-page">
        <header class="page-heading">
            <p class="eyebrow">{tr.weather.location}</p>
            <h1>{tr.weather.title}</h1>
            <p>{tr.weather.description}</p>
        </header>

        {error || !weather ? (
            <div class="error-card" role="status">
                <i class="fa-solid fa-cloud-bolt" aria-hidden="true"></i>
                <p>{tr.weather.unavailable}</p>
            </div>
        ) : (
            <>
                <section class={`road-card ${isDifficult ? "road-card--difficult" : ""}`} aria-labelledby="road-title">
                    <div class="road-heading">
                        <div class="road-icon"><i class="fa-solid fa-road" aria-hidden="true"></i></div>
                        <div>
                            <p class="section-kicker" id="road-title">{tr.weather.road_estimate}</p>
                            <h2>{tr.weather.road}</h2>
                        </div>
                        <span class="road-status">{isDifficult ? tr.weather.difficult : tr.weather.passable}</span>
                    </div>
                    {showWarning && (
                        <p class="weather-warning">
                            <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>
                            {tr.weather.warning}
                        </p>
                    )}
                    <p class="road-disclaimer">{tr.weather.road_disclaimer}</p>
                </section>

                <div class="weather-grid">
                    <section class="current-card" aria-labelledby="current-weather-title">
                        <div class="current-summary">
                            <div>
                                <p class="section-kicker">{tr.weather.today}</p>
                                <h2 id="current-weather-title">{getWeatherDesc(weather.weather_code)}</h2>
                                <p class="current-date">
                                    {formatDate(weather.time.split("T")[0], { weekday: "long", day: "numeric", month: "long" })}
                                </p>
                            </div>
                            <img
                                src={getWeatherIcon(weather.weather_code)}
                                alt={getWeatherDesc(weather.weather_code)}
                                class:list={["current-icon", { "night-icon": weather.is_day === 0 }]}
                            />
                        </div>

                        <div class="temperature">
                            <strong>{Math.round(weather.temperature_2m)}°</strong>
                            <span>{tr.weather.feels_like} {Math.round(weather.apparent_temperature)}°C</span>
                        </div>

                        <dl class="weather-stats">
                            <div>
                                <dt><i class="fa-solid fa-droplet" aria-hidden="true"></i>{tr.weather.precipitation}</dt>
                                <dd>{weather.precipitation_probability}%</dd>
                            </div>
                            <div>
                                <dt><i class="fa-solid fa-water" aria-hidden="true"></i>{tr.weather.humidity}</dt>
                                <dd>{weather.relative_humidity_2m}%</dd>
                            </div>
                            <div>
                                <dt><i class="fa-solid fa-wind" aria-hidden="true"></i>{tr.weather.wind}</dt>
                                <dd>{Math.round(weather.wind_speed_10m)} <small>km/h</small></dd>
                            </div>
                        </dl>

                        <p class="updated">{tr.weather.updated}: {formatUpdated(weather.time)}</p>
                    </section>

                    <section class="hourly-card" aria-labelledby="hourly-title">
                        <div class="section-heading">
                            <div>
                                <p class="section-kicker">{tr.weather.today}</p>
                                <h2 id="hourly-title">{tr.weather.hourly_forecast}</h2>
                            </div>
                        </div>
                        <div class="hourly-list">
                            {hourlyForecast.map((hour) => (
                                <article class="hour-card">
                                    <time datetime={hour.time}>{hour.time.split("T")[1]}</time>
                                    <img src={getWeatherIcon(hour.code)} alt={getWeatherDesc(hour.code)} />
                                    <strong>{hour.temp}°</strong>
                                </article>
                            ))}
                        </div>
                    </section>
                </div>

                <section class="forecast-section" aria-labelledby="forecast-title">
                    <div class="section-heading">
                        <div>
                            <p class="section-kicker">Smetovi</p>
                            <h2 id="forecast-title">{tr.weather.forecast}</h2>
                        </div>
                    </div>
                    <div class="daily-grid">
                        {dailyForecast.map((day, index) => (
                            <article class:list={["day-card", { "day-card--today": index === 0 }]}>
                                <time datetime={day.date}>
                                    <strong>{index === 0 ? tr.weather.today : formatDate(day.date, { weekday: "short" })}</strong>
                                    <span>{formatDate(day.date, { day: "2-digit", month: "2-digit" })}</span>
                                </time>
                                <img src={getWeatherIcon(day.code)} alt={getWeatherDesc(day.code)} />
                                <p>{getWeatherDesc(day.code)}</p>
                                <div class="day-temperatures">
                                    <strong>{day.high}°</strong>
                                    <span>{day.low}°</span>
                                </div>
                                <span class="day-precip"><i class="fa-solid fa-droplet" aria-hidden="true"></i>{day.precip}%</span>
                            </article>
                        ))}
                    </div>
                </section>
            </>
        )}

        <section class="cameras-section" aria-labelledby="cameras-title">
            <div class="section-heading">
                <div>
                    <p class="section-kicker">{tr.weather.coming_soon}</p>
                    <h2 id="cameras-title">{tr.weather.cameras_preparation}</h2>
                </div>
            </div>
            <div class="camera-grid">
                <article class="camera-card">
                    <div class="camera-placeholder">
                        <i class="fa-solid fa-video-slash" aria-hidden="true"></i>
                        <span>{tr.weather.coming_soon}</span>
                    </div>
                    <p><i class="fa-solid fa-location-dot" aria-hidden="true"></i>M-17: Zenica sjever</p>
                </article>
                <article class="camera-card">
                    <div class="camera-placeholder">
                        <i class="fa-solid fa-video-slash" aria-hidden="true"></i>
                        <span>{tr.weather.coming_soon}</span>
                    </div>
                    <p><i class="fa-solid fa-location-dot" aria-hidden="true"></i>Smetovi</p>
                </article>
            </div>
        </section>

        <p class="data-source">
            {tr.weather.source}: <a href="https://open-meteo.com/" target="_blank" rel="noopener noreferrer">Open-Meteo</a>
        </p>
    </main>
</PageLayout>

<style>
    .weather-page {
        width: min(1180px, 90%);
        margin: 0 auto;
        padding: 7.5rem 0 4rem;
        color: #374151;
        font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        box-shadow: 0 0 0 100vmax #f9fafb;
        clip-path: inset(0 -100vmax);
    }

    .page-heading {
        max-width: 720px;
        margin-bottom: 2rem;
    }

    .page-heading h1 {
        margin: 0.2rem 0 0.65rem;
        color: #111827;
        font-family: inherit;
        font-weight: 800;
        font-size: clamp(2.25rem, 5vw, 3.6rem);
        line-height: 1.05;
    }

    .page-heading > p:last-child {
        margin: 0;
        color: #6b7280;
        font-size: 1.08rem;
    }

    .eyebrow,
    .section-kicker {
        margin: 0;
        color: #f97316;
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
    }

    .road-card,
    .current-card,
    .hourly-card,
    .forecast-section,
    .cameras-section,
    .error-card {
        border: 1px solid #f3f4f6;
        border-radius: 1.5rem;
        background: #fff;
        box-shadow: 0 8px 24px rgba(17, 24, 39, 0.06);
    }

    .road-card {
        position: relative;
        margin-bottom: 1.25rem;
        padding: 1.1rem 12rem 1.1rem 1.25rem;
        border-left: 5px solid #16a34a;
    }

    .road-card--difficult {
        border-left-color: #e07819;
        background: #fffaf3;
    }

    .road-heading {
        display: flex;
        align-items: center;
        gap: 0.9rem;
    }

    .road-icon {
        display: grid;
        width: 2.75rem;
        height: 2.75rem;
        flex: 0 0 auto;
        place-items: center;
        border-radius: 0.85rem;
        background: #eff6ff;
        color: #2563eb;
    }

    .road-heading h2,
    .section-heading h2,
    .current-summary h2 {
        margin: 0.15rem 0 0;
        color: #1f2937;
        font-family: inherit;
        font-weight: 800;
    }

    .road-heading h2 {
        font-size: 1.15rem;
    }

    .road-status {
        position: absolute;
        top: 50%;
        right: 1.5rem;
        display: inline-flex;
        align-items: center;
        align-self: center;
        justify-content: center;
        margin-left: 0;
        padding: 0.55rem 1rem;
        border-radius: 999px;
        background: #16a34a;
        color: #fff;
        font-size: 0.9rem;
        font-weight: 800;
        letter-spacing: 0.04em;
        line-height: 1;
        box-shadow: 0 5px 14px rgba(22, 163, 74, 0.22);
        text-transform: uppercase;
        transform: translateY(-50%);
    }

    .road-card--difficult .road-status {
        background: #ea580c;
        color: #fff;
        box-shadow: 0 5px 14px rgba(234, 88, 12, 0.22);
    }

    .weather-warning {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin: 0.85rem 0 0;
        color: #a64b09;
        font-weight: 700;
    }

    .road-disclaimer {
        margin: 0.8rem 0 0;
        color: #6b7280;
        font-size: 0.85rem;
    }

    .weather-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr);
        gap: 1.25rem;
    }

    .current-card,
    .hourly-card,
    .forecast-section,
    .cameras-section {
        padding: 1.5rem;
    }

    .current-card {
        background: #fff;
    }

    .current-summary {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
    }

    .current-summary h2,
    .section-heading h2 {
        font-size: 1.55rem;
    }

    .current-summary h2 {
        color: #f97316;
    }

    .current-date {
        margin: 0.35rem 0 0;
        color: #9ca3af;
        text-transform: capitalize;
    }

    .current-icon {
        width: 8rem;
        height: 8rem;
        object-fit: contain;
        filter: drop-shadow(0 12px 12px rgba(37, 99, 235, 0.13));
    }

    .night-icon {
        filter: brightness(0.82);
    }

    .temperature {
        display: flex;
        align-items: baseline;
        gap: 1rem;
        margin: 0.7rem 0 1.5rem;
    }

    .temperature strong {
        color: #111827;
        font-family: inherit;
        font-weight: 900;
        font-size: clamp(3.8rem, 9vw, 5.6rem);
        line-height: 1;
    }

    .temperature span {
        color: #6b7280;
    }

    .weather-stats {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        margin: 0;
        overflow: hidden;
        border: 1px solid #dbeafe;
        border-radius: 1rem;
        background: #eff6ff;
    }

    .weather-stats > div {
        padding: 0.85rem;
        text-align: center;
    }

    .weather-stats > div + div {
        border-left: 1px solid #dbeafe;
    }

    .weather-stats dt {
        display: flex;
        justify-content: center;
        gap: 0.35rem;
        color: #6b7280;
        font-size: 0.75rem;
    }

    .weather-stats dd {
        margin: 0.3rem 0 0;
        color: #1f2937;
        font-size: 1.15rem;
        font-weight: 700;
    }

    .weather-stats small {
        font-size: 0.7rem;
        font-weight: 400;
    }

    .updated {
        margin: 0.8rem 0 0;
        color: #9ca3af;
        font-size: 0.78rem;
        text-align: right;
    }

    .section-heading {
        display: flex;
        align-items: end;
        justify-content: space-between;
        margin-bottom: 1.2rem;
    }

    .hourly-list {
        display: grid;
        grid-template-columns: repeat(4, minmax(82px, 1fr));
        gap: 0.7rem;
    }

    .hour-card {
        display: flex;
        min-height: 128px;
        flex-direction: column;
        align-items: center;
        justify-content: space-between;
        padding: 0.75rem 0.45rem;
        border: 1px solid #f3f4f6;
        border-radius: 1rem;
        background: #fff;
        box-shadow: 0 3px 10px rgba(17, 24, 39, 0.04);
    }

    .hour-card:hover {
        border-color: #93c5fd;
        box-shadow: 0 6px 18px rgba(37, 99, 235, 0.1);
    }

    .hour-card time {
        color: #9ca3af;
        font-size: 0.78rem;
    }

    .hour-card img {
        width: 2.8rem;
        height: 2.8rem;
        object-fit: contain;
    }

    .hour-card strong {
        font-size: 1.12rem;
    }

    .forecast-section,
    .cameras-section {
        margin-top: 1.25rem;
    }

    .daily-grid {
        display: grid;
        grid-template-columns: repeat(7, minmax(0, 1fr));
        gap: 0.7rem;
    }

    .day-card {
        display: flex;
        min-width: 0;
        flex-direction: column;
        align-items: center;
        gap: 0.6rem;
        padding: 1rem 0.55rem;
        border: 1px solid #f3f4f6;
        border-radius: 1rem;
        text-align: center;
    }

    .day-card--today {
        border-color: #93c5fd;
        background: #eff6ff;
    }

    .day-card time {
        display: flex;
        flex-direction: column;
        text-transform: capitalize;
    }

    .day-card time span {
        color: #9ca3af;
        font-size: 0.75rem;
    }

    .day-card img {
        width: 3.4rem;
        height: 3.4rem;
        object-fit: contain;
    }

    .day-card > p {
        min-height: 2.2rem;
        margin: 0;
        color: #6b7280;
        font-size: 0.8rem;
        line-height: 1.15;
    }

    .day-temperatures {
        display: flex;
        gap: 0.45rem;
    }

    .day-temperatures span {
        color: #9ca3af;
    }

    .day-precip {
        display: flex;
        align-items: center;
        gap: 0.25rem;
        color: #187aa1;
        font-size: 0.75rem;
    }

    .camera-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1rem;
    }

    .camera-card {
        padding: 0.75rem;
        border: 1px solid #f3f4f6;
        border-radius: 1rem;
        background: #fafcfc;
    }

    .camera-placeholder {
        display: grid;
        min-height: 145px;
        place-content: center;
        gap: 0.55rem;
        border-radius: 0.75rem;
        background: linear-gradient(145deg, #374151, #111827);
        color: #d1d5db;
        text-align: center;
    }

    .camera-placeholder i {
        font-size: 1.8rem;
    }

    .camera-placeholder span {
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
    }

    .camera-card p {
        display: flex;
        align-items: center;
        gap: 0.45rem;
        margin: 0.7rem 0 0.1rem;
        color: #6b7280;
    }

    .data-source {
        margin: 1rem 0 0;
        color: #9ca3af;
        font-size: 0.78rem;
        text-align: right;
    }

    .data-source a {
        color: #f97316;
        font-weight: 700;
    }

    .error-card {
        display: flex;
        align-items: center;
        gap: 0.8rem;
        padding: 1.4rem;
        color: #a64030;
    }

    .error-card p {
        margin: 0;
    }

    @media (max-width: 900px) {
        .weather-grid {
            grid-template-columns: 1fr;
        }

        .daily-grid {
            grid-template-columns: repeat(4, minmax(0, 1fr));
        }
    }

    @media (max-width: 600px) {
        .weather-page {
            width: 100%;
            padding: 6.25rem 1rem 3rem;
            overflow: hidden;
        }

        .page-heading {
            margin-bottom: 1.4rem;
        }

        .page-heading h1 {
            font-size: 2.15rem;
        }

        .page-heading > p:last-child {
            font-size: 1rem;
            line-height: 1.45;
        }

        .road-card,
        .current-card,
        .hourly-card,
        .forecast-section,
        .cameras-section {
            min-width: 0;
            padding: 1rem;
            border-radius: 1.1rem;
        }

        .road-card {
            padding: 1rem;
        }

        .road-heading {
            display: grid;
            grid-template-columns: auto minmax(0, 1fr);
            align-items: center;
        }

        .road-status {
            position: static;
            grid-column: 1 / -1;
            width: auto;
            min-width: 9rem;
            margin: 0.45rem auto 0;
            justify-self: center;
            text-align: center;
            transform: none;
        }

        .road-disclaimer {
            line-height: 1.35;
        }

        .weather-grid {
            gap: 1rem;
        }

        .current-summary {
            align-items: center;
        }

        .current-summary h2,
        .section-heading h2 {
            font-size: 1.3rem;
        }

        .current-icon {
            width: 4.5rem;
            height: 4.5rem;
            flex: 0 0 auto;
        }

        .temperature {
            display: grid;
            gap: 0.3rem;
            margin: 1rem 0 1.25rem;
        }

        .temperature strong {
            font-size: 4rem;
        }

        .temperature span {
            font-size: 0.9rem;
        }

        .weather-stats {
            grid-template-columns: 1fr;
        }

        .weather-stats > div {
