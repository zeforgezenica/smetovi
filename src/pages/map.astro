---
import MapComponent from "../components/MapComponent";
import { getCollection } from "astro:content";
import type { MapPin } from "../models/map.pin.model";
import PageLayout from "../layouts/PageLayout.astro";
import { getLangFromCookie } from "../i18n/server";
import { t } from "../i18n";

const organizations = await getCollection("organizations");
const lang = getLangFromCookie(Astro.cookies.get("lang")?.value);
const tr = t(lang);

const pins: MapPin[] = organizations.map((org) => ({
  type: org.data.type,
  title: org.data.title,
  location: org.data.location,
  path: `/organizations/${org.slug}/`,
  img: org.data.heroImage,
  mapUrl: org.data.mapUrl,
}));
---

<PageLayout
  siteTitle={`${tr.map.title} | Smetovi`}
  siteDescription={tr.map.description}
  includeFooter={false}
>
  <main>
    <MapComponent
      client:load
      {pins}
      labels={{
        details: lang === "en" ? "Details" : "Detalji",
        navigation: lang === "en" ? "Directions" : "Navigacija",
        legend: lang === "en" ? "Map legend" : "Legenda mape",
        food: lang === "en" ? "Food" : "Hrana",
        accommodation: lang === "en" ? "Accommodation" : "Smještaj",
        activities: lang === "en" ? "Activities" : "Aktivnosti",
        services: lang === "en" ? "Services and education" : "Službe i edukacija",
        parking: lang === "en" ? "Parking" : "Parking",
        resort: lang === "en" ? "Smetovi memorial" : "Spomenik Smetovi",
      }}
    />
  </main>
</PageLayout>

<style>
  main {
    height: 100vh;
    width: 100vw;
  }
</style>
