---
import { getCollection } from "astro:content";
import FormattedDate from "../../components/FormattedDate.astro";
import PageLayout from "../../layouts/PageLayout.astro";
import { getLangFromCookie } from "../../i18n/server";
import { t } from "../../i18n";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const lang = getLangFromCookie(Astro.cookies.get("lang")?.value);
const tr = t(lang);
---

<PageLayout
  siteTitle={`${tr.blog.title} | Smetovi`}
  siteDescription={tr.blog.description}
>
  <main class="pt-24 pb-12">
    <header class="flex flex-col items-center px-4 mb-10 text-center">
      <h1 id="news-title" class="text-4xl md:text-5xl font-exo2 font-bold text-sky-950 mb-2 uppercase tracking-wide">
        {tr.blog.title}
      </h1>
      <div class="w-24 h-1 bg-orange-500 mb-4"></div>
      <p class="text-gray-600 max-w-2xl text-lg">
        {tr.blog.description}
      </p>
    </header>
    <section aria-labelledby="news-title">
      <ul class="space-y-6">
        {
          posts.map((post) => (
            <li>
              <a
                href={`/blog/${post.slug}/`}
                class="group block w-4/5 max-w-6xl mx-auto no-underline focus-visible:outline-none"
              >
                <article class="organization flex flex-col md:flex-row bg-white shadow-md overflow-hidden transition duration-300 ease-out group-hover:-translate-y-1 group-hover:shadow-xl group-focus-visible:-translate-y-1 group-focus-visible:shadow-xl group-focus-visible:ring-4 group-focus-visible:ring-orange-500/70">
                  <div class="org-image flex-none md:w-1/4 h-48 md:h-auto overflow-hidden">
                    <img
                      src={post.data.heroImage}
                      alt={post.data.title}
                      class="object-cover w-full h-full transition-transform duration-500 ease-out group-hover:scale-105 group-focus-visible:scale-105"
                    />
                  </div>
                  <div class="org-content flex flex-col justify-center items-start flex-grow p-4">
                    <p class="date mb-0 text-gray-400">
                      <FormattedDate date={post.data.pubDate} />
                    </p>
                    {
                      post.data.sourceName && (
                        <span class="mb-2 inline-flex items-center gap-2 border-l-4 border-orange-500 pl-2 text-sm font-bold text-sky-950">
                          <i
                            class={
                              post.data.sourcePlatform === "facebook"
                                ? "fa-brands fa-facebook text-orange-500"
                                : "fa-solid fa-building text-orange-500"
                            }
                            aria-hidden="true"
                          />
                          {tr.blog.shared_by}: {post.data.sourceName}
                        </span>
                      )
                    }
                    <h4 class="title font-bold font-exo2 text-lg text-sky-950 sm:text-base md:text-xl lg:text-2xl xl:text-3xl">
                      {post.data.title}
                    </h4>
                    <span
                      class="inline-block bg-sky-950 px-6 py-2 text-white transition-colors duration-200 group-hover:bg-orange-500 group-focus-visible:bg-orange-500"
                      style="clip-path: polygon(0 0, calc(100% - 10px) 0, 100% 10px, 100% 100%, 10px 100%, 0 calc(100% - 10px));"
                    >
                      {tr.blog.read_more}
                    </span>
                  </div>
                </article>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </main>
</PageLayout>
