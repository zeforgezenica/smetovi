--- 
import BaseHead from "../../components/BaseHead.astro"; 
import Header from '../../components/Header.astro'; 
import Footer from '../../components/Footer.astro'; 
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts'; 
import MapComponent from "../../components/MapComponent";
import { getCollection } from "astro:content";
import type { MapPin } from "../../models/map.pin.model";
import { getLangFromUrl } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);

// Get organizations collection
const organizations = await getCollection('organizations');

// Create pins with English-aware URLs
const pins: MapPin[] = organizations.map(org => ({
  type: org.data.type,
  title: org.data.title,
  location: org.data.location,
  path: `/en/organizations/${org.slug}/`,  // English URL path
  img: org.data.heroImage,
}));
---

<html lang="en">
<head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
</head>
<body>
    <Header />
    <main>
        <MapComponent client:load {pins} lang={lang}/>
    </main>
</body>
</html>

<style>
    main {
        height: 100vh;
        width: 100vw;
    }
</style>
