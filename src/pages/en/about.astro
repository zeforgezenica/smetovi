---
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import BaseHead from "../../components/BaseHead.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../../consts";
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body class="about-page">
    
    <Header />
    <main class="flex flex-col justify-center w-[90%] lg:w-[85%] mx-auto mt-24">
      
      <!-- Hero Section -->
      <section class="about-hero mb-12">
        <h1 class="md:px-2 max-md:mx-2 rounded font-exo2 uppercase text-3xl sm:text-4xl md:text-5xl font-bold mb-4">
          About Us
        </h1>
        <hr class="md:px-2 mx-2 bg-yellow border-0 h-1 w-56 mb-6" />
        <p class="md:px-2 max-md:mx-2 text-lg mb-8">
          Welcome to Smetovi - the mountain that connects nature, tradition and community
        </p>
      </section>

      <!-- Content Sections -->
      <div class="flex flex-col lg:flex-row gap-8">
        
        <!-- Left Column -->
        <section class="about-content w-full lg:w-1/2">
          <h2 class="md:px-2 max-md:mx-2 font-exo2 uppercase text-2xl sm:text-3xl font-bold mb-4">
            Our Mission
          </h2>
          <hr class="md:px-2 mx-2 bg-yellow border-0 h-1 w-40 mb-4" />
          <p class="m-2 mb-6">
            Smetovi represents an oasis of nature in the heart of Bosnia and Herzegovina. Our mission is 
            preserving natural heritage, promoting sustainable tourism and connecting people with 
            nature through hiking and recreational activities.
          </p>

          <h2 class="md:px-2 max-md:mx-2 font-exo2 uppercase text-2xl sm:text-3xl font-bold mb-4 mt-8">
            Our History
          </h2>
          <hr class="md:px-2 mx-2 bg-yellow border-0 h-1 w-40 mb-4" />
          <p class="m-2 mb-6">
            Mount Smetovi has been home to the local community for centuries, preserving rich traditions 
            and natural beauty. Today we continue to nurture this heritage through organized 
            activities and nature conservation programs.
          </p>
        </section>

        <!-- Right Column -->
        <section class="about-content w-full lg:w-1/2">
          
          <!-- Adding the missing "What We Offer" section -->
          <h2 class="md:px-2 max-md:mx-2 font-exo2 uppercase text-2xl sm:text-3xl font-bold mb-4">
            What We Offer
          </h2>
          <hr class="md:px-2 mx-2 bg-yellow border-0 h-1 w-40 mb-4" />
          <div class="m-2 mb-6">
            <div class="mb-3 flex gap-3">
              <span><i class="fa-solid fa-mountain text-darkBlue"></i></span>
              <span>Hiking and walking trails</span>
            </div>
            <div class="mb-3 flex gap-3">
              <span><i class="fa-solid fa-camera text-darkBlue"></i></span>
              <span>Nature photography</span>
            </div>
            <div class="mb-3 flex gap-3">
              <span><i class="fa-solid fa-users text-darkBlue"></i></span>
              <span>Group activities and events</span>
            </div>
            <div class="mb-3 flex gap-3">
              <span><i class="fa-solid fa-leaf text-darkBlue"></i></span>
              <span>Nature education</span>
            </div>
          </div>

          <h2 class="md:px-2 max-md:mx-2 font-exo2 uppercase text-2xl sm:text-3xl font-bold mb-4 mt-8">
            Join Us
          </h2>
          <hr class="md:px-2 mx-2 bg-yellow border-0 h-1 w-40 mb-4" />
          <p class="m-2 mb-4">
            Become part of our community of nature lovers! Follow our activities, 
            join our events and discover the charms of Mount Smetovi.
          </p>
          <div class="m-2">
            <a href="/en/contact">
              <div class="diagonal-border p-[2px] bg-darkBlue">
                <div class="diagonal-square px-4 py-2 w-40">
                  Contact us
                </div>
              </div>
            </a>
          </div>
        </section>
      </div>

      <!-- Testimonials Section -->
      <section class="testimonials-section mt-16 mb-12">
        <h2 class="md:px-2 max-md:mx-2 font-exo2 uppercase text-3xl sm:text-4xl font-bold mb-4 text-center">
          What our visitors say
        </h2>
        <hr class="bg-yellow border-0 h-1 w-56 mb-12 mx-auto" />
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          
          <!-- Testimonial 1 -->
          <div class="testimonial-card bg-white p-6 rounded-lg shadow-lg border-l-4 border-yellow">
            <div class="flex items-center mb-4">
              <div class="testimonial-avatar bg-darkBlue text-white rounded-full w-12 h-12 flex items-center justify-center mr-3">
                <i class="fa-solid fa-user"></i>
              </div>
              <div>
                <h4 class="font-bold text-darkBlue">Mark Johnson</h4>
                <p class="text-sm text-gray-600">London, UK</p>
              </div>
            </div>
            <div class="flex mb-3">
              <i class="fa-solid fa-star text-yellow"></i>
              <i class="fa-solid fa-star text-yellow"></i>
              <i class="fa-solid fa-star text-yellow"></i>
              <i class="fa-solid fa-star text-yellow"></i>
              <i class="fa-solid fa-star text-yellow"></i>
            </div>
            <p class="text-gray-700 italic">
              "Smetovi is a true gem! Incredible views, clean air and excellent hiking trails. 
              Will definitely return with my family."
            </p>
          </div>

          <!-- Testimonial 2 -->
          <div class="testimonial-card bg-white p-6 rounded-lg shadow-lg border-l-4 border-yellow">
            <div class="flex items-center mb-4">
              <div class="testimonial-avatar bg-darkBlue text-white rounded-full w-12 h-12 flex items-center justify-center mr-3">
                <i class="fa-solid fa-user"></i>
              </div>
              <div>
                <h4 class="font-bold text-darkBlue">Sarah Williams</h4>
                <p class="text-sm text-gray-600">Berlin, Germany</p>
              </div>
            </div>
            <div class="flex mb-3">
              <i class="fa-solid fa-star text-yellow"></i>
              <i class="fa-solid fa-star text-yellow"></i>
              <i class="fa-solid fa-star text-yellow"></i>
              <i class="fa-solid fa-star text-yellow"></i>
              <i class="fa-solid fa-star text-yellow"></i>
            </div>
            <p class="text-gray-700 italic">
              "They organized a fantastic guided tour. The guide was very knowledgeable and experienced. 
              I recommend it to everyone who loves nature!"
            </p>
          </div>

          <!-- Testimonial 3 -->
          <div class="testimonial-card bg-white p-6 rounded-lg shadow-lg border-l-4 border-yellow">
            <div class="flex items-center mb-4">
              <div class="testimonial-avatar bg-darkBlue text-white rounded-full w-12 h-12 flex items-center justify-center mr-3">
                <i class="fa-solid fa-user"></i>
              </div>
              <div>
                <h4 class="font-bold text-darkBlue">James Anderson</h4>
                <p class="text-sm text-gray-600">Vienna, Austria</p>
              </div>
            </div>
            <div class="flex mb-3">
              <i class="fa-solid fa-star text-yellow"></i>
              <i class="fa-solid fa-star text-yellow"></i>
              <i class="fa-solid fa-star text-yellow"></i>
              <i class="fa-solid fa-star text-yellow"></i>
              <i class="fa-solid fa-star text-gray-300"></i>
            </div>
            <p class="text-gray-700 italic">
              "Excellent place to escape from city noise. I especially like that they organize 
              mountain cleaning activities. Bravo for the effort!"
            </p>
          </div>

          <!-- Testimonial 4 -->
          <div class="testimonial-card bg-white p-6 rounded-lg shadow-lg border-l-4 border-yellow">
            <div class="flex items-center mb-4">
              <div class="testimonial-avatar bg-darkBlue text-white rounded-full w-12 h-12 flex items-center justify-center mr-3">
                <i class="fa-solid fa-user"></i>
              </div>
              <div>
                <h4 class="font-bold text-darkBlue">Emma Thompson</h4>
                <p class="text-sm text-gray-600">Manchester, UK</p>
              </div>
            </div>
            <div class="flex mb-3">
              <i class="fa-solid fa-star text-yellow"></i>
              <i class="fa-solid fa-star text-yellow"></i>
              <i class="fa-solid fa-star text-yellow"></i>
              <i class="fa-solid fa-star text-yellow"></i>
              <i class="fa-solid fa-star text-yellow"></i>
            </div>
            <p class="text-gray-700 italic">
              "We participated with our children in an educational workshop about local fauna. 
              The kids were thrilled, and we adults learned a lot too!"
            </p>
          </div>

          <!-- Testimonial 5 -->
          <div class="testimonial-card bg-white p-6 rounded-lg shadow-lg border-l-4 border-yellow">
            <div class="flex items-center mb-4">
              <div class="testimonial-avatar bg-darkBlue text-white rounded-full w-12 h-12 flex items-center justify-center mr-3">
                <i class="fa-solid fa-user"></i>
              </div>
              <div>
                <h4 class="font-bold text-darkBlue">David Miller</h4>
                <p class="text-sm text-gray-600">Amsterdam, Netherlands</p>
              </div>
            </div>
            <div class="flex mb-3">
              <i class="fa-solid fa-star text-yellow"></i>
              <i class="fa-solid fa-star text-yellow"></i>
              <i class="fa-solid fa-star text-yellow"></i>
              <i class="fa-solid fa-star text-yellow"></i>
              <i class="fa-solid fa-star text-yellow"></i>
            </div>
            <p class="text-gray-700 italic">
              "As a photographer, I can say that Smetovi offers spectacular shots. 
              Every season has its own charm and beauty."
            </p>
          </div>

          <!-- Testimonial 6 -->
          <div class="testimonial-card bg-white p-6 rounded-lg shadow-lg border-l-4 border-yellow">
            <div class="flex items-center mb-4">
              <div class="testimonial-avatar bg-darkBlue text-white rounded-full w-12 h-12 flex items-center justify-center mr-3">
                <i class="fa-solid fa-user"></i>
              </div>
              <div>
                <h4 class="font-bold text-darkBlue">Lisa Garcia</h4>
                <p class="text-sm text-gray-600">Barcelona, Spain</p>
              </div>
            </div>
            <div class="flex mb-3">
              <i class="fa-solid fa-star text-yellow"></i>
              <i class="fa-solid fa-star text-yellow"></i>
              <i class="fa-solid fa-star text-yellow"></i>
              <i class="fa-solid fa-star text-yellow"></i>
              <i class="fa-solid fa-star text-gray-300"></i>
            </div>
            <p class="text-gray-700 italic">
              "First visit to Smetovi, but definitely not the last! 
              The mountain lodge is comfortable and the staff is very friendly."
            </p>
          </div>

        </div>

        <!-- Call to Action for Reviews -->
        <div class="text-center mt-12">
          <h3 class="font-exo2 uppercase text-xl font-bold mb-4 text-darkBlue">
            Share your experience
          </h3>
          <p class="mb-6 text-gray-700">
            Have you visited Smetovi? Share your experience with others!
          </p>
          <a href="/en/contact">
            <div class="diagonal-border p-[2px] bg-darkBlue inline-block">
              <div class="diagonal-square px-6 py-3">
                Leave a review
              </div>
            </div>
          </a>
        </div>
      </section>

    </main>
    <Footer />

    <svg width="0" height="0" class="hidden">
      <defs>
        <mask id="diagonal-mask" maskUnits="objectBoundingBox">
          <polygon fill="white" points="
            0,0         <!-- top-left -->
            0.9,0       <!-- almost top-right -->
            1,0.1       <!-- diagonal top-right -->
            1,1         <!-- bottom-right -->
            0.1,1       <!-- almost bottom-left -->
            0,0.9       <!-- diagonal bottom-left -->
          " />
        </mask>
      </defs>
    </svg>
  </body>
</html>
