---
import PageLayout from "../layouts/PageLayout.astro";
import { getLangFromCookie } from "../i18n/server";
import { t } from "../i18n";


const lang = getLangFromCookie(Astro.cookies.get("lang")?.value);
const tr = t(lang);
---

<PageLayout
  siteTitle={`${tr.contact.title} | Smetovi`}
  siteDescription={tr.contact.page_description}
>
  <main class="flex flex-col md:flex-row justify-center w-[90%] lg:w-[85%] mx-auto mt-24">
    <section class="contact-form-section contact-info w-full md:w-1/2 box-border h-100 m-3">
      <h1 class="md:px-2 max-md:mx-2 rounded font-exo2 uppercase text-3xl sm:text-4xl md:text-5xl font-bold mb-4">
        {tr.contact.title}
      </h1>
      <hr class="md:px-2 mx-2 bg-yellow border-0 h-1 w-56" />
      <div class="m-2 flex gap-3">
        <span><i class="fa-solid fa-location-dot"></i></span>
        <span>{tr.contact.location}</span>
      </div>
      <div class="m-2 flex gap-3">
        <span><i class="fa-solid fa-phone"></i></span>
        <span>032 979 844</span>
      </div>
      <div class="m-2 flex gap-3">
        <span><i class="fa-solid fa-envelope"></i></span>
        <span>info@zeforge.ba</span>
      </div>
      <h2 class="md:px-2 max-md:mx-2 rounded font-exo2 uppercase text-3xl sm:text-4xl md:text-5xl font-bold mt-8 mb-4">
        {tr.contact.newsletter_title}
      </h2>
      <hr class="md:px-2 mx-2 bg-yellow border-0 h-1 w-56" />
      <p class="m-2 mb-4">{tr.contact.newsletter_desc}</p>
      <form
        id="newsletterForm"
        class="flex flex-col sm:flex-row gap-2 m-2 w-[95%]"
        data-sending={tr.contact.sending}
        data-success={tr.contact.newsletter_success}
        data-error={tr.contact.newsletter_error}
      >
        <label for="newsletter-email" class="sr-only">{tr.contact.email}</label>
        <input
            id="newsletter-email"
            name="email"
            type="email"
            required
            autocomplete="email"
            aria-describedby="newsletter-status"
            class="flex-1 p-2 border border-gray-300 rounded focus:border-darkBlue outline-none transition-all"
            placeholder={tr.contact.email_placeholder}
        />
        <button id="newsletter-submit" type="submit" class="shrink-0 disabled:cursor-wait disabled:opacity-60">
          <div class="diagonal-border p-[2px] bg-darkBlue hover:bg-blue-800 transition-colors">
            <div id="newsletter-submit-label" class="diagonal-square px-4 py-2 bg-white text-darkBlue font-bold text-center w-40">
              {tr.contact.subscribe}
            </div>
          </div>
        </button>
      </form>
      <p id="newsletter-status" class="m-2 min-h-6 text-sm font-bold" role="status" aria-live="polite"></p>
    </section>

    <section class="flex contact-form-section contact-form w-full md:w-1/2 p-1 box-border h-100 m-3">
      <form
          id="contactForm"
          class="space-y-4 h-120 flex flex-col flex-1 items-start"
          data-sending={tr.contact.sending}
          data-success={tr.contact.message_success}
          data-error={tr.contact.message_error}
      >
        <div class="w-full flex flex-col md:flex-row gap-5">
          <div class="w-full">
            <label for="name" class="block text-sm font-medium text-gray-700">{tr.contact.first_name}</label>
            <input
                type="text" id="name" name="name" required autocomplete="given-name"
                class="w-full p-2 border border-gray-300 rounded focus:border-darkBlue outline-none"
                placeholder={tr.contact.first_name_placeholder}
            />
          </div>
          <div class="w-full">
            <label for="lastName" class="block text-sm font-medium text-gray-700">{tr.contact.last_name}</label>
            <input
                type="text" id="lastName" name="lastName" required autocomplete="family-name"
                class="w-full p-2 border border-gray-300 rounded focus:border-darkBlue outline-none"
                placeholder={tr.contact.last_name_placeholder}
            />
          </div>
        </div>

        <label for="email" class="block text-sm font-medium text-gray-700">{tr.contact.email}</label>
        <input
            type="email" id="email" name="email" required autocomplete="email"
            class="w-full p-2 border border-gray-300 rounded"
            placeholder={tr.contact.email_placeholder}
        />

        <label for="subject" class="block text-sm font-medium text-gray-700">{tr.contact.subject}</label>
        <input
            type="text" id="subject" name="subject" required
            class="w-full p-2 border border-gray-300 rounded"
            placeholder={tr.contact.subject_placeholder}
        />

        <label for="message" class="block text-sm font-medium text-gray-700">{tr.contact.message}</label>
        <textarea
            id="message" name="message" rows="5" required
            class="w-full h-full p-5 border border-gray-300 rounded"
            placeholder={tr.contact.message_placeholder}
        ></textarea>

        <button id="contact-submit" type="submit" class="disabled:cursor-wait disabled:opacity-60">
          <div id="contact-submit-label" class="diagonal-border px-4 py-3 w-40 bg-darkBlue text-white">
            {tr.contact.send}
          </div>
        </button>
        <p id="contact-status" class="min-h-6 text-sm font-bold" role="status" aria-live="polite"></p>
      </form>
    </section>
  </main>

  <script>
    async function sendInquiryEmail(formData: FormData) {
      const values = Object.fromEntries(formData.entries());
      const emailData = {
        subject: values.subject || "No Subject",
        text: `Nova poruka od korisnika smetovi.ba:\n\nIme: ${values.name}\nPrezime: ${values.lastName}\nKontakt: ${values.email}\nDetalji: ${values.message}`,
        senderName: values.name,
        senderContact: values.email,
      };
      await sendEmail(emailData);
    }

    async function sendNewsletterEmail(formData: FormData) {
      const values = Object.fromEntries(formData.entries());
      const emailData = {
        subject: "Newsletter",
        text: `Korisnik sa e-mail adresom "${values.email}" se želi pretplatiti na sadržaj web stranice smetovi.ba.`,
        senderName: "Newsletter",
        senderContact: values.email,
      };
      await sendEmail(emailData);
    }

    async function sendEmail(formData: object) {
      const response = await fetch("https://busezapi.zeforge.ba/sendEmail", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(formData),
      });
      if (!response.ok) {
        throw new Error(`Email API returned ${response.status}`);
      }
    }

    async function submitForm(
      form: HTMLFormElement,
      button: HTMLButtonElement,
      buttonLabel: HTMLElement,
      status: HTMLElement,
      sender: (formData: FormData) => Promise<void>,
    ) {
      const defaultLabel = buttonLabel.textContent ?? "";
      button.disabled = true;
      form.setAttribute("aria-busy", "true");
      buttonLabel.textContent = form.dataset.sending ?? "";
      status.textContent = "";

      try {
        await sender(new FormData(form));
        status.textContent = form.dataset.success ?? "";
        status.className = "min-h-6 text-sm font-bold text-green-700";
        form.reset();
      } catch (error) {
        console.error("Error sending form:", error);
        status.textContent = form.dataset.error ?? "";
        status.className = "min-h-6 text-sm font-bold text-red-700";
      } finally {
        button.disabled = false;
        form.removeAttribute("aria-busy");
        buttonLabel.textContent = defaultLabel;
      }
    }

    const contactForm = document.getElementById("contactForm") as HTMLFormElement | null;
    const contactButton = document.getElementById("contact-submit") as HTMLButtonElement | null;
    const contactButtonLabel = document.getElementById("contact-submit-label");
    const contactStatus = document.getElementById("contact-status");

    contactForm?.addEventListener("submit", async function (event) {
      event.preventDefault();
      if (contactButton && contactButtonLabel && contactStatus) {
        await submitForm(contactForm, contactButton, contactButtonLabel, contactStatus, sendInquiryEmail);
      }
    });

    const newsletterForm = document.getElementById("newsletterForm") as HTMLFormElement | null;
    const newsletterButton = document.getElementById("newsletter-submit") as HTMLButtonElement | null;
    const newsletterButtonLabel = document.getElementById("newsletter-submit-label");
    const newsletterStatus = document.getElementById("newsletter-status");

    newsletterForm?.addEventListener("submit", async function (event) {
      event.preventDefault();
      if (newsletterButton && newsletterButtonLabel && newsletterStatus) {
        await submitForm(newsletterForm, newsletterButton, newsletterButtonLabel, newsletterStatus, sendNewsletterEmail);
      }
    });
  </script>

  <svg width="0" height="0" class="hidden">
    <defs>
      <mask id="diagonal-mask" maskUnits="objectBoundingBox">
        <polygon fill="white" points="0,0 0.9,0 1,0.1 1,1 0.1,1 0,0.9"></polygon>
      </mask>
    </defs>
  </svg>
</PageLayout>
