---
import { getCollection } from "astro:content";
import "../../styles/global.css";
import PageLayout from "../../layouts/PageLayout.astro";
import { getLangFromCookie } from "../../i18n/server";
import { t } from "../../i18n";

const lang = getLangFromCookie(Astro.cookies.get("lang")?.value);
const tr = t(lang);

const posts = await getCollection("organizations");

function isOpen(workHours: string): boolean | null {
  if (!workHours.includes("-")) return null;
  
  const [openTime, closeTime] = workHours
      .split("-")
      .map((time) => parseInt(time));
      
  if (isNaN(openTime) || isNaN(closeTime)) return null;

  const currentHour = new Date().getHours();
  return currentHour >= openTime && currentHour < closeTime;
}
---

<PageLayout
  siteTitle={`${tr.organizations.title} | Smetovi`}
  siteDescription={tr.organizations.description}
>
  <main class="pt-24 pb-12">
    <header class="flex flex-col items-center px-4 mb-10 text-center">
      <h1 id="organizations-title" class="text-4xl md:text-5xl font-exo2 font-bold text-sky-950 mb-2 uppercase tracking-wide">
        {tr.organizations.title}
      </h1>
      <div class="w-24 h-1 bg-orange-500 mb-4"></div>
      <p class="text-gray-600 max-w-2xl text-lg">
        {tr.organizations.description}
      </p>
    </header>
    <section aria-labelledby="organizations-title">
      <ul class="space-y-6">
        {
          posts.map((post) => {
            const postIsOpen = isOpen(post.data.workHours);
            return (
              <li>
                <a
                  href={`/organizations/${post.slug}/`}
                  class="group block w-4/5 max-w-6xl mx-auto no-underline focus-visible:outline-none"
                >
                  <article class="organization flex flex-col md:flex-row bg-white shadow-md overflow-hidden transition duration-300 ease-out group-hover:-translate-y-1 group-hover:shadow-xl group-focus-visible:-translate-y-1 group-focus-visible:shadow-xl group-focus-visible:ring-4 group-focus-visible:ring-orange-500/70">
                    <div class="org-image flex-none md:w-1/4 h-48 md:h-auto overflow-hidden">
                      <img
                          src={post.data.heroImage}
                          alt={post.data.title}
                          class={`object-cover w-full h-full transition duration-500 ease-out group-hover:scale-105 group-focus-visible:scale-105 ${postIsOpen === false ? "filter grayscale" : ""}`}
                      />
                    </div>
                    <div class="org-content flex flex-col justify-center items-start flex-grow p-4">
                      <h4 class="title font-exo2 text-lg text-sky-950 sm:text-base md:text-xl lg:text-2xl xl:text-3xl font-bold">
                        {post.data.title}
                      </h4>
                      <h5 class="text-sm sm:text-base md:text-lg lg:text-xl xl:text-2xl text-gray-600">
                        {tr.organizations.work_hours}: {post.data.workHours}
                      </h5>
                      <h5
                          class={`text-sm sm:text-base md:text-lg lg:text-xl xl:text-2xl font-bold 
                        ${postIsOpen === null ? "text-gray-500" : (postIsOpen ? "text-pastel-green" : "text-tomato-red")}`}
                      >
                        {postIsOpen === null ? tr.organizations.unknown : (postIsOpen ? tr.organizations.open : tr.organizations.closed)}
                      </h5>
                    </div>
                  </article>
                </a>
              </li>
            );
          })
        }
      </ul>
    </section>
  </main>
</PageLayout>
