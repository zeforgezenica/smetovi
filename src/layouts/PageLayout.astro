---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import "../styles/global.css";
import { getLangFromCookie } from "../i18n/server";

interface Props {
  siteTitle?: string;
  siteDescription?: string;
  includeFooter?: boolean;
}

const { siteTitle, siteDescription, includeFooter = true } = Astro.props;
const lang = getLangFromCookie(Astro.cookies.get("lang")?.value);
---

<!doctype html>
<html lang={lang}>
  <BaseHead title={siteTitle} description={siteDescription} lang={lang} />

  <body>
    <Header />

    <slot />

    {includeFooter && <Footer />}
  </body>
</html>
