---
import type { CollectionEntry } from "astro:content";
import FormattedDate from "../components/FormattedDate.astro";
import PageLayout from "./PageLayout.astro";
import { getLangFromCookie } from "../i18n/server";
import { t } from "../i18n";

type Props = CollectionEntry<"blog">["data"];
const {
  title,
  description,
  pubDate,
  heroImage,
  photoAuthor,
  sourceName,
  sourceUrl,
  sourcePlatform,
} = Astro.props;
const lang = getLangFromCookie(Astro.cookies.get("lang")?.value);
const tr = t(lang);
---

<PageLayout
  siteTitle={`${title} | Smetovi`}
  siteDescription={description}
  socialImage={heroImage}
>
  <main class="w-full m-0">
    {heroImage && (
      <div class="image-container">
        <img src={heroImage} alt={title} class="hero-image" />
      </div>
    )}

    <article>
      <div class="prose">
        <div class="title mb-4">
          <div class="date font-atkinson text-gray-500 mb-2">
            {pubDate && (
              <div class="last-updated-on">
                <FormattedDate date={pubDate} />
              </div>
            )}
          </div>
          <h1 class="text-3xl font-exo2 font-bold mb-2">{title}</h1>
          <div class="ttl-sep w-20 h-1 bg-orange-500 my-2"></div>
          <h2 class="photo-author font-atkinson text-gray-500 text-lg">
            {photoAuthor}
          </h2>
        </div>
        <slot />
        {
          sourceName && sourceUrl && (
            <aside class="source-card" aria-label={tr.blog.shared_by}>
              <div class="source-icon" aria-hidden="true">
                <i
                  class={
                    sourcePlatform === "facebook"
                      ? "fa-brands fa-facebook-f"
                      : "fa-solid fa-building"
                  }
                />
              </div>
              <div class="source-content">
                <span>{tr.blog.shared_by}</span>
                <strong>{sourceName}</strong>
                <p>{tr.blog.source_note}</p>
              </div>
              <a
                href={sourceUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="source-link"
              >
                <span>
                  {tr.blog.original_post}
                  <span aria-hidden="true">↗</span>
                </span>
              </a>
            </aside>
          )
        }
      </div>
    </article>
  </main>
</PageLayout>

<style>
  .image-container {
    width: 100%;
    height: 70vh;
    position: relative;
    overflow: hidden;
  }

  .hero-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .prose {
    width: 720px;
    max-width: calc(100% - 2em);
    background-color: white;
    margin: 2em auto 0;
    padding: 3em;
    color: rgb(var(--gray-dark));
    box-shadow:
      0 0 50px rgba(150, 150, 150, 0.5),
      0 0 50px rgba(150, 150, 150, 0.5);
    flex-grow: 1;
    min-height: calc(100vh - 64px);
    overflow: visible;
    border-radius: 12px;
    position: relative;
    z-index: 2;
  }

  .title {
    text-align: left;
  }

  .photo-author {
    text-align: left;
  }

  .source-card {
    position: relative;
    display: flex;
    gap: 1rem;
    align-items: center;
    margin-top: 3rem;
    border: 1px solid #f3f4f6;
    border-left: 4px solid #f97316;
    border-radius: 1.5rem;
    background: white;
    padding: 1.4rem 13rem 1.4rem 1.4rem;
    box-shadow: 0 8px 24px rgba(17, 24, 39, 0.06);
  }

  .source-icon {
    display: grid;
    width: 3rem;
    height: 3rem;
    flex: 0 0 auto;
    place-items: center;
    border-radius: 0.85rem;
    background: #f0f9ff;
    color: #082f49;
    font-size: 1.2rem;
  }

  .source-content {
    display: flex;
    min-width: 0;
    flex-direction: column;
  }

  .source-content span {
    color: #f97316;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .source-content strong {
    color: #082f49;
    font-family: "Exo2", sans-serif;
    font-size: 1.05rem;
  }

  .source-content p {
    margin: 0.15rem 0 0;
    color: #64748b;
    font-size: 0.85rem;
    line-height: 1.4;
  }

  .source-link {
    position: absolute;
    top: 50%;
    right: 1.4rem;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: #082f49;
    font-size: 0.85rem;
    font-weight: 700;
    text-decoration: none;
    transform: translateY(-50%);
  }

  .source-link:hover {
    color: #f97316;
  }

  .source-link:focus-visible {
    outline: 3px solid #f97316;
    outline-offset: 3px;
  }

  @media (max-width: 768px) {
    .image-container {
      height: 50vh;
    }

    .prose {
      padding: 1.5em;
      margin-top: 1.5em;
    }

    .source-card {
      display: grid;
      grid-template-columns: auto 1fr;
      padding: 1.25rem;
    }

    .source-link {
      position: static;
      grid-column: 1 / -1;
      margin-top: 0.25rem;
      transform: none;
    }
  }
</style>
